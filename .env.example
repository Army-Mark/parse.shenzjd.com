# =========================================================
# 短视频解析站 - 环境变量示例
# 用法：复制本文件为 .env 后按需填写；所有变量均可选（不配即有默认/自动禁用）。
#
# 本版本为「已剥离第三方微信认证」的自建版：原 WXAUTH_API_BASE 已废弃移除，
# 解析接口不再要求登录。
# =========================================================

# ---- 站点身份（可选；不配置时使用代码内默认值：口袋时光 / 113826.xyz）----
# NEXT_PUBLIC_ 变量在构建期注入，须在 build / deploy 前设置好并重新构建才生效
# NEXT_PUBLIC_SITE_NAME=口袋时光
# NEXT_PUBLIC_SITE_DOMAIN=113826.xyz
# NEXT_PUBLIC_SITE_URL=https://parse.113826.xyz
# 联系邮箱默认留空（法律页会隐藏邮箱并显示中性提示）；需要展示时再填
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_COPYRIGHT_EMAIL=

# ---- 跨域放行（可选；不配则不返回 CORS 头，同源调用不受影响）----
# 逗号分隔，支持子域，例：ALLOWED_ORIGINS=113826.xyz,parse.113826.xyz
# ALLOWED_ORIGINS=

# ---- 抖音（提升解析成功率）----
# DOUYIN_COOKIE=your_cookie

# ---- 微博（提升解析成功率）----
# WEIBO_COOKIE=your_cookie

# ---- B站请求出口（海外服务器必须二选一，绕过 B站 IP 风控 -412）----
# 方式一：云函数中继（推荐，见 scf-bilibili-relay/README.md）
# BILIBILI_RELAY_URL=https://<函数公网URL>
# BILIBILI_RELAY_TOKEN=<与云函数 RELAY_TOKEN 一致>
# 方式二：HTTP 代理
# BILIBILI_PROXY=http://[user:pass@]host:port
# 优先级：中继 > 代理 > 直连

# ---- 解析行为统计（Turso/libsql；未配置时记录功能自动禁用）----
# TURSO_DB_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token
# /api/stats 只读统计接口的访问密钥（Bearer）。未配置则该接口返回 503 关闭。
# 调用方式：curl -H "Authorization: Bearer <STATS_API_KEY>" https://你的域名/api/stats
# 建议用 openssl rand -hex 32 生成
# STATS_API_KEY=

# ---- TikTok yt-dlp（Docker 部署内已自带 yt-dlp，一般无需配置）----
# YTDLP_BIN=yt-dlp
# YTDLP_TIMEOUT_MS=25000

# ---- 视频解析入口开关（/api/config 读取；值需为 "true" 才放开，默认关闭）----
# VIDEO_PARSE_ENABLED=true
