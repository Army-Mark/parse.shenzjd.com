diff --git a/.github/workflows/selfhost-sync.yml b/.github/workflows/selfhost-sync.yml
new file mode 100644
index 0000000..ef87324
--- /dev/null
+++ b/.github/workflows/selfhost-sync.yml
@@ -0,0 +1,451 @@
+name: Self-host sync (reapply overlay on upstream)
+
+# 作用：保留上游同步能力，同时保证本地「自建改造」不被上游覆盖。
+#
+# 机制（补丁栈重放）：
+#   1. 拉取上游最新代码
+#   2. 把工作区完全重置为上游（丢弃本地历史）
+#   3. 从本仓库上一个正常版本取回 selfhost/ 叠加层（补丁 + 删除清单）
+#   4. 在干净的上游代码上重新应用补丁、执行删除
+#   5. 运行不变量守卫 → 单元测试 → 生产构建 → 固定上游工作流文件
+#   6. 全部通过才提交并推送；任何一步失败即中止，线上保持上一个正常版本
+#
+# 为什么不直接用 merge：
+#   merge 对「不冲突」的改动会静默采纳上游版本。上游一旦在别处重新引入被剥离的
+#   第三方认证代码，merge 不会报冲突，改造会被悄悄抵消。重置 + 重放 + 守卫的组合
+#   让这种情况必须以「任务失败」的形式暴露，而不是静默退化。
+#
+# 关于 .github/workflows：
+#   GitHub 禁止用默认 GITHUB_TOKEN 推送任何工作流文件改动。因此本任务在提交前会把
+#   上游工作流文件固定为「上一个正常版本」，使本次推送在 .github/workflows 下没有
+#   任何差异（唯一的自有工作流 selfhost-sync.yml 内容也不变），默认 token 即可推送。
+#   代价：上游对工作流文件的改进不会自动生效；需要时用带 workflow 权限的 SYNC_TOKEN
+#   并把「Pin upstream workflow files」这一步删掉。
+#
+# 前置（一次性）：
+#   首次提交本工作流需要一个能写 .github/workflows 的凭据，请在本地用你自己的
+#   PAT / SSH 推送一次，之后每日同步即可全自动。
+#
+# 部署（jobs.deploy）：
+#   同步成功后把 standalone 产物推送到服务器并重启 systemd 服务，形成
+#   「上游更新 → GitHub → 服务器」全自动链路。用到的 Secrets / Variables 见
+#   selfhost/README.md「自动部署」一节；未配置任何 DEPLOY_* 时 deploy 任务会
+#   明确报错中止（不会静默跳过），避免误以为已经部署。
+#
+#   变更检测：只有 sync 真的产生了新提交（changed=true）才部署，上游没动就不做
+#   无谓的构建与重启 —— 重启服务会短暂中断线上解析。需要强制重部署（例如只改了
+#   服务器 .env）时用 workflow_dispatch 的 force_deploy。
+
+on:
+  schedule:
+    - cron: "0 3 * * *" # 每天 03:00 UTC（北京时间 11:00）
+  workflow_dispatch:
+    inputs:
+      force_deploy:
+        description: "即使代码无变化，也重新构建并部署到服务器"
+        type: boolean
+        default: false
+
+permissions:
+  contents: write
+
+concurrency:
+  group: selfhost-sync
+  cancel-in-progress: false
+
+env:
+  # 上游仓库（按需修改）
+  UPSTREAM_REPO: wu529778790/parse.shenzjd.com
+  UPSTREAM_BRANCH: main
+  # 本叠加层自有的工作流文件，不参与「固定上游工作流」步骤
+  OWN_WORKFLOW: .github/workflows/selfhost-sync.yml
+
+jobs:
+  sync:
+    runs-on: ubuntu-latest
+    # 只在本 fork 中运行；上游自身无需自同步，避免每天空跑
+    if: github.repository != 'wu529778790/parse.shenzjd.com'
+    outputs:
+      # 传给 deploy：只有真的产生了「覆盖上游的新提交」才需要动线上。
+      # 上游没人动 → changed=false → 不做无谓的构建与重启。
+      changed: ${{ steps.commit.outputs.changed }}
+      branch: ${{ steps.b.outputs.default }}
+    # 构建期注入：NEXT_PUBLIC_* 会被打进客户端产物，必须在 `npm run build` 之前设好。
+    # 全部取自仓库 Variables（Settings → Secrets and variables → Actions → Variables），
+    # 未配置时为空串，src/config/site.ts 会回退到本仓库内置的默认值。
+    env:
+      NEXT_PUBLIC_SITE_NAME: ${{ vars.NEXT_PUBLIC_SITE_NAME }}
+      NEXT_PUBLIC_SITE_DOMAIN: ${{ vars.NEXT_PUBLIC_SITE_DOMAIN }}
+      NEXT_PUBLIC_SITE_URL: ${{ vars.NEXT_PUBLIC_SITE_URL }}
+      NEXT_PUBLIC_COPYRIGHT_EMAIL: ${{ vars.NEXT_PUBLIC_COPYRIGHT_EMAIL }}
+      NEXT_PUBLIC_CONTACT_EMAIL: ${{ vars.NEXT_PUBLIC_CONTACT_EMAIL }}
+      # 稳定 buildId：next.config.mjs 的 generateBuildId 未指定时回退到 Date.now()，
+      # 会造成同一次部署的前后端 ID 不一致（RSC / Server Action 报「找不到 action」）。
+      NEXT_BUILD_ID: ${{ github.sha }}
+    steps:
+      - name: Checkout fork
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          # 有 SYNC_TOKEN 就用它（可推送工作流改动），否则用默认 token
+          token: ${{ secrets.SYNC_TOKEN || github.token }}
+
+      - name: Git identity
+        run: |
+          git config user.name  "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+      - name: Resolve default branch
+        id: b
+        run: |
+          DEFAULT="${{ github.event.repository.default_branch }}"
+          if [ -z "$DEFAULT" ]; then DEFAULT=main; fi
+          echo "default=$DEFAULT" >> $GITHUB_OUTPUT
+          echo "默认分支: $DEFAULT"
+
+      - name: Fetch origin and upstream
+        run: |
+          set -e
+          git fetch --prune --tags origin "+refs/heads/*:refs/remotes/origin/*"
+          git remote add upstream "https://github.com/${UPSTREAM_REPO}.git" \
+            || git remote set-url upstream "https://github.com/${UPSTREAM_REPO}.git"
+          git fetch --prune --tags upstream \
+            "+refs/heads/${UPSTREAM_BRANCH}:refs/remotes/upstream/${UPSTREAM_BRANCH}"
+
+      - name: Remember last good overlay commit
+        id: last
+        run: |
+          set -e
+          SHA="$(git rev-parse "origin/${{ steps.b.outputs.default }}")"
+          echo "sha=$SHA" >> $GITHUB_OUTPUT
+          echo "上一个正常版本: $SHA"
+          git log -1 --format='  %h %s' "$SHA"
+
+      - name: Stash overlay aside
+        # 叠加层必须取自「上一个正常版本」：紧接着要把工作区重置为上游，
+        # 重置会把 selfhost/ 一并删除。scripts/ 由补丁负责重建，这里不取，
+        # 否则会与补丁里的「新增文件」冲突。
+        run: |
+          set -e
+          rm -rf /tmp/selfhost-overlay
+          mkdir -p /tmp/selfhost-overlay
+          if ! git cat-file -e "${{ steps.last.outputs.sha }}:selfhost/delete.txt" 2>/dev/null; then
+            echo "::error::上一个版本中不存在 selfhost/delete.txt，叠加层不完整，请先本地导出并推送一次"
+            exit 1
+          fi
+          git archive "${{ steps.last.outputs.sha }}" selfhost | tar -x -C /tmp/selfhost-overlay
+          echo "取回叠加层："
+          find /tmp/selfhost-overlay -type f | sed 's|/tmp/selfhost-overlay/||' | sort
+
+      - name: Reset working tree to upstream
+        run: |
+          set -e
+          git checkout -B "${{ steps.b.outputs.default }}" "upstream/${UPSTREAM_BRANCH}"
+          echo "工作区已重置为上游 $(git rev-parse --short HEAD)"
+
+      - name: Restore overlay files
+        run: |
+          set -e
+          cp -r /tmp/selfhost-overlay/selfhost ./selfhost
+          test -s selfhost/delete.txt || { echo "::error::selfhost/delete.txt 为空或缺失"; exit 1; }
+
+      - name: Reapply overlay patches
+        run: |
+          set -e
+          shopt -s nullglob
+          patches=(selfhost/patches/*.patch)
+          if [ ${#patches[@]} -eq 0 ]; then
+            echo "::error::selfhost/patches 下没有补丁，无法重建自建改造"
+            exit 1
+          fi
+          for p in "${patches[@]}"; do
+            echo "== 应用 $p"
+            if ! git apply --3way --whitespace=nowarn "$p"; then
+              echo "::error file=$p::补丁应用失败：上游改动与本地改造冲突"
+              echo "---- 冲突文件 ----"
+              git diff --name-only --diff-filter=U || true
+              echo "---- 冲突详情（前 200 行）----"
+              git diff | head -200 || true
+              exit 1
+            fi
+          done
+          echo "补丁全部应用完成"
+
+      - name: Apply deletions
+        # 删除用 git rm 而非补丁：对上游的任何改动都免疫，不会造成冲突
+        run: |
+          set -e
+          while IFS= read -r line; do
+            case "$line" in ''|'#'*) continue ;; esac
+            if [ -e "$line" ] || git ls-files --error-unmatch "$line" >/dev/null 2>&1; then
+              echo "删除 $line"
+              git rm -rf -q -f --ignore-unmatch -- "$line"
+            else
+              echo "跳过（已不存在）$line"
+            fi
+          done < selfhost/delete.txt
+
+      - name: Pin upstream workflow files
+        # 让 .github/workflows 下除本叠加层自有工作流外，内容与本仓库上一个版本完全一致，
+        # 从而本次推送不构成「工作流文件改动」，默认 GITHUB_TOKEN 也可以推送。
+        run: |
+          set -e
+          LAST="${{ steps.last.outputs.sha }}"
+          # 1) 上游新增的工作流文件：本次不引入（保持与上一版本一致的集合）
+          while IFS= read -r f; do
+            [ -z "$f" ] && continue
+            [ "$f" = "${OWN_WORKFLOW}" ] && continue
+            if ! git cat-file -e "$LAST:$f" 2>/dev/null; then
+              echo "移除上游新增工作流: $f"
+              rm -f "$f"
+              git rm -q -f --ignore-unmatch -- "$f" 2>/dev/null || true
+            fi
+          done < <(git ls-files .github/workflows)
+          # 2) 其余工作流文件：固定为上一版本的内容
+          while IFS= read -r f; do
+            [ -z "$f" ] && continue
+            [ "$f" = "${OWN_WORKFLOW}" ] && continue
+            echo "固定工作流为上个版本: $f"
+            git show "$LAST:$f" > "$f"
+          done < <(git ls-tree -r --name-only "$LAST" -- .github/workflows | grep -v "^${OWN_WORKFLOW}$" || true)
+
+      - name: Guard self-host invariants
+        run: node scripts/selfhost-guard.mjs
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: "npm"
+
+      - name: Reconcile lockfile with patched package.json
+        # package-lock.json 不进入补丁 —— 锁文件是派生产物，上游每次依赖升降级都会
+        # 重写它，放进补丁会让三方合并频繁冲突（详见 scripts/export-overlay.mjs）。
+        # 代价是：应用补丁后 package.json 可能与上游锁文件不再一致（本地移除了
+        # @opennextjs/cloudflare）。故此处按 package.json 重新生成锁文件，
+        # 使随后的 `npm ci` 同步校验可以通过。改动会由 Commit 步骤一并提交。
+        run: npm install --package-lock-only --ignore-scripts --no-audit --no-fund
+
+      - name: Verify (install + test + build)
+        run: |
+          npm ci
+          npm test
+          npm run build
+
+      - name: Package standalone bundle
+        # Next.js 的 standalone 产物**不含** .next/static 与 public，必须显式补进去，
+        # 否则线上页面无样式、无图标 —— 这是 standalone 部署最常见的坑。
+        run: |
+          set -e
+          STAGE=/tmp/parse-bundle
+          rm -rf "$STAGE"
+          mkdir -p "$STAGE"
+          cp -r .next/standalone/. "$STAGE/"
+          mkdir -p "$STAGE/.next/static"
+          cp -r .next/static/. "$STAGE/.next/static/"
+          if [ -d public ]; then
+            mkdir -p "$STAGE/public"
+            cp -r public/. "$STAGE/public/"
+          fi
+          # 缺任何一项都会让服务起不来或页面错乱，这里前置校验，宁可失败也不上线半成品
+          test -f "$STAGE/server.js"
+          test -d "$STAGE/node_modules"
+          test -d "$STAGE/.next/static"
+          test -s "$STAGE/.next/BUILD_ID"
+          # 落一个可读标记，部署端据此确认拿到的是本次构建
+          printf '%s\n' "$(cat .next/BUILD_ID)" > "$STAGE/BUILD_ID.txt"
+          tar -czf /tmp/parse-bundle.tar.gz -C "$STAGE" .
+          ls -lh /tmp/parse-bundle.tar.gz
+          echo "BUILD_ID=$(cat .next/BUILD_ID)"
+
+      - name: Upload bundle artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: parse-standalone
+          path: /tmp/parse-bundle.tar.gz
+          retention-days: 3
+          if-no-files-found: error
+
+      - name: Commit overlay
+        id: commit
+        run: |
+          set -e
+          git add -A
+          if git diff --cached --quiet; then
+            echo "changed=false" >> $GITHUB_OUTPUT
+            echo "与上游无差异，无需提交"
+          else
+            SHORT="$(git rev-parse --short "upstream/${UPSTREAM_BRANCH}")"
+            git commit -q -m "chore(selfhost): reapply overlay on upstream ${SHORT}"
+            echo "changed=true" >> $GITHUB_OUTPUT
+            git --no-pager diff --stat "upstream/${UPSTREAM_BRANCH}" HEAD | tail -30
+          fi
+
+      - name: Push
+        if: steps.commit.outputs.changed == 'true'
+        run: |
+          set -e
+          git push --force-with-lease origin "HEAD:${{ steps.b.outputs.default }}"
+
+  # ---------------------------------------------------------------------------
+  # 部署到服务器（systemd）
+  #
+  # 为什么必须放在同一个工作流里、而不是靠 deploy-to-docker.yaml 的 push 触发：
+  #   用默认 GITHUB_TOKEN 提交的推送**不会**触发其他工作流（GitHub 的反递归保护），
+  #   所以 sync 推完代码后，监听 push 的部署工作流根本不会启动。要么写在同一个
+  #   工作流里用 needs 串起来，要么用 PAT 推送 —— 这里选前者，少一个长期凭据。
+  #
+  # 为什么不用 Docker：本服务器线上是 systemd + node 直跑（/opt/parse/app + server.js），
+  #   Docker 路径会去抢同一个 3000 端口。两者只能留一个，这里与线上保持一致。
+  # ---------------------------------------------------------------------------
+  deploy:
+    name: Deploy to server (systemd)
+    needs: sync
+    runs-on: ubuntu-latest
+    # 上游仓库自身不部署；只有真产生了新提交（changed=true）才动线上，
+    # 避免每天空跑一次构建 + 重启（重启会短暂中断线上解析）。
+    # 手动触发时可勾选 force_deploy 忽略变更检测强制重部署。
+    if: >-
+      github.repository != 'wu529778790/parse.shenzjd.com'
+      && (needs.sync.outputs.changed == 'true' || inputs.force_deploy == true)
+    steps:
+      - name: Download bundle
+        uses: actions/download-artifact@v4
+        with:
+          name: parse-standalone
+          path: ./bundle
+
+      - name: Check deploy configuration
+        env:
+          HOST: ${{ secrets.DEPLOY_HOST }}
+          USER: ${{ secrets.DEPLOY_USER }}
+          KEY: ${{ secrets.DEPLOY_SSH_KEY }}
+        run: |
+          set -e
+          missing=""
+          [ -n "$HOST" ] || missing="$missing DEPLOY_HOST"
+          [ -n "$USER" ] || missing="$missing DEPLOY_USER"
+          [ -n "$KEY" ] || missing="$missing DEPLOY_SSH_KEY"
+          if [ -n "$missing" ]; then
+            echo "::error::缺少部署配置:$missing —— 请在 Settings → Secrets and variables → Actions 中补齐，参考 selfhost/README.md「自动部署」。"
+            exit 1
+          fi
+          echo "部署目标: $USER@$HOST"
+
+      - name: Set up SSH
+        env:
+          KEY: ${{ secrets.DEPLOY_SSH_KEY }}
+          KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
+          HOST: ${{ secrets.DEPLOY_HOST }}
+          PORT: ${{ secrets.DEPLOY_PORT || 22 }}
+        run: |
+          set -e
+          mkdir -p ~/.ssh
+          printf '%s\n' "$KEY" > ~/.ssh/deploy_key
+          chmod 600 ~/.ssh/deploy_key
+          if [ -n "$KNOWN_HOSTS" ]; then
+            printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
+          else
+            # 未提供固定指纹时退化为首次扫描：方便但有中间人风险。
+            # 生产环境建议把 `ssh-keyscan -p <端口> <主机>` 的输出存成 DEPLOY_KNOWN_HOSTS。
+            ssh-keyscan -p "$PORT" "$HOST" > ~/.ssh/known_hosts 2>/dev/null
+          fi
+          chmod 600 ~/.ssh/known_hosts
+
+      - name: Upload bundle to server
+        env:
+          HOST: ${{ secrets.DEPLOY_HOST }}
+          USER: ${{ secrets.DEPLOY_USER }}
+          PORT: ${{ secrets.DEPLOY_PORT || 22 }}
+          TMP_DIR: ${{ vars.DEPLOY_TMP_DIR || '/tmp' }}
+        run: |
+          set -e
+          scp -P "$PORT" -i ~/.ssh/deploy_key \
+            -o IdentitiesOnly=yes -o BatchMode=yes \
+            bundle/parse-bundle.tar.gz "${USER}@${HOST}:${TMP_DIR}/parse-bundle.tar.gz"
+
+      - name: Apply on server and restart service
+        env:
+          HOST: ${{ secrets.DEPLOY_HOST }}
+          USER: ${{ secrets.DEPLOY_USER }}
+          PORT: ${{ secrets.DEPLOY_PORT || 22 }}
+          APP_DIR: ${{ vars.DEPLOY_APP_DIR }}
+          SERVICE: ${{ vars.DEPLOY_SERVICE }}
+          OWNER: ${{ vars.DEPLOY_OWNER }}
+          TMP_DIR: ${{ vars.DEPLOY_TMP_DIR || '/tmp' }}
+          HEALTH_URL: ${{ vars.DEPLOY_HEALTH_URL }}
+        run: |
+          set -e
+          ssh -p "$PORT" -i ~/.ssh/deploy_key \
+            -o IdentitiesOnly=yes -o BatchMode=yes \
+            -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
+            "${USER}@${HOST}" \
+            "APP_DIR='${APP_DIR}' SERVICE='${SERVICE}' OWNER='${OWNER}' TMP_DIR='${TMP_DIR}' HEALTH_URL='${HEALTH_URL}' bash -s" <<'REMOTE'
+          set -euo pipefail
+          APP_DIR="${APP_DIR:-/opt/parse/app}"
+          SERVICE="${SERVICE:-parse}"
+          OWNER="${OWNER:-parse}"
+          TMP_DIR="${TMP_DIR:-/tmp}"
+          HEALTH_URL="${HEALTH_URL:-http://127.0.0.1:3000/}"
+          PARENT="$(dirname "$APP_DIR")"
+
+          # 写 $APP_DIR 与重启 systemd 都需要 root：root 直连，或用免密 sudo。
+          if [ "$(id -u)" -eq 0 ]; then SUDO=""
+          elif sudo -n true 2>/dev/null; then SUDO="sudo"
+          else
+            echo "错误：部署用户既非 root 也没有免密 sudo，无法写入 $APP_DIR 或重启 $SERVICE" >&2
+            exit 1
+          fi
+
+          BUNDLE="$TMP_DIR/parse-bundle.tar.gz"
+          [ -s "$BUNDLE" ] || { echo "错误：服务器上不存在 $BUNDLE" >&2; exit 1; }
+          OLD_ID="$(cat "$APP_DIR/.next/BUILD_ID" 2>/dev/null || echo unknown)"
+
+          # 先解到暂存目录并校验，再整体替换：直接往运行目录解包会让服务在被访问时
+          # 处于「一半旧一半新」的状态
+          STAGE="$PARENT/.stage.$$"
+          $SUDO rm -rf "$STAGE"
+          $SUDO mkdir -p "$STAGE"
+          $SUDO tar -xzf "$BUNDLE" -C "$STAGE"
+          [ -f "$STAGE/server.js" ] || { echo "错误：产物缺少 server.js" >&2; exit 1; }
+          [ -d "$STAGE/.next/static" ] || { echo "错误：产物缺少 .next/static" >&2; exit 1; }
+          NEW_ID="$(cat "$STAGE/.next/BUILD_ID" 2>/dev/null || echo unknown)"
+          echo "BUILD_ID: $OLD_ID -> $NEW_ID"
+
+          BACKUP="$PARENT/.backup.prev"
+          $SUDO rm -rf "$BACKUP"
+          if [ -d "$APP_DIR" ]; then $SUDO mv "$APP_DIR" "$BACKUP"; fi
+          $SUDO mv "$STAGE" "$APP_DIR"
+          $SUDO chown -R "$OWNER:$OWNER" "$APP_DIR"
+          # 站点配置在 $PARENT/.env（systemd EnvironmentFile 读取），不在本站目录内，
+          # 因此整目录替换不会覆盖服务器上的环境变量
+          $SUDO rm -f "$BUNDLE"
+
+          $SUDO systemctl restart "$SERVICE"
+
+          ok=0
+          for i in $(seq 1 20); do
+            sleep 3
+            code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" 2>/dev/null || echo 000)"
+            if [ "$code" = "200" ]; then ok=1; echo "健康检查通过（第 ${i} 次，HTTP $code）"; break; fi
+            echo "  第 ${i} 次未通过（HTTP $code）"
+          done
+
+          # 健康检查不通过就回滚：线上宁可是上一个正常版本，也不要一个起不来的新版本
+          if [ "$ok" != "1" ]; then
+            echo "健康检查失败，回滚到上一版本" >&2
+            $SUDO rm -rf "$APP_DIR"
+            if [ -d "$BACKUP" ]; then
+              $SUDO mv "$BACKUP" "$APP_DIR"
+              $SUDO systemctl restart "$SERVICE"
+              sleep 3
+              echo "已回滚，恢复后状态：$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" 2>/dev/null || echo 000)" >&2
+            fi
+            echo "---- $SERVICE 最近日志 ----" >&2
+            $SUDO journalctl -u "$SERVICE" -n 40 --no-pager >&2 || true
+            exit 1
+          fi
+
+          $SUDO rm -rf "$BACKUP"
+          echo "部署完成：$APP_DIR（BUILD_ID $NEW_ID）"
+          REMOTE
